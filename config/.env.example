# PostgreSQL connection string from your managed Postgres provider.
DATABASE_URL=

# Apify API token (Apify Console > Settings > API & Integrations). Searches are in config/searches.toml.
APIFY_TOKEN=
# Optional: minutes to wait for each Apify run before recording it as failed (default 60).
APIFY_MAX_WAIT_MINUTES=

# LLM-powered matching, tailoring, cover letters, skill gaps, and interview preparation.
# Any OpenAI-compatible chat-completions endpoint; leave LLM_BASE_URL empty for OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: a different model to review tailored CVs and cover letters (a second opinion
# catches more). Each empty setting falls back to the one above; a different
# LLM_REVIEW_BASE_URL needs its own LLM_REVIEW_API_KEY.
LLM_REVIEW_MODEL=
LLM_REVIEW_BASE_URL=
LLM_REVIEW_API_KEY=

# Tavily API key for company research: needed by interview-prep, optional for tailor-cv and cover-letter.
WEB_SEARCH_API_KEY=
