# PostgreSQL connection string from your managed Postgres provider.
DATABASE_URL=postgresql://user:password@host:5432/jobflow?sslmode=require

# Apify API token (Apify Console > Settings > API & Integrations). Searches are in searches.toml.
APIFY_TOKEN=

# Optional: minutes to wait for each Apify run before recording it as failed (default 60).
APIFY_MAX_WAIT_MINUTES=

# LLM-powered matching, tailoring, and interview preparation.
# Any OpenAI-compatible chat-completions endpoint; leave LLM_BASE_URL empty for OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Tavily API key for jobflow interview-prep company research.
WEB_SEARCH_API_KEY=
