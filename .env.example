# PostgreSQL connection string from your managed Postgres provider.
DATABASE_URL=postgresql://user:password@host:5432/jobflow?sslmode=require

# Apify API token and comma-separated saved Task IDs (preserves scraper inputs).
APIFY_TOKEN=
APIFY_TASK_IDS=

# Set later for LLM-powered matching and interview preparation.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
WEB_SEARCH_API_KEY=

# Optional private object storage settings for raw datasets and generated files.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
